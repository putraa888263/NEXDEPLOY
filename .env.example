# Used by Docker Compose on the VPS. Never commit the real .env file.
NEXDEPLOY_ENCRYPTION_KEY=replace-with-a-long-random-secret
EXECUTOR_TOKEN=replace-with-a-long-random-token
PANEL_PORT=3000

# Optional Nginx Proxy Manager compose override.
# NPM admin UI will be available on NPM_ADMIN_PORT.
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# Existing NPM account used by the panel to create/update Proxy Hosts.
# NPM_FORWARD_HOST is what NPM should forward project domains to.
# Use the VPS public IP, host.docker.internal, or another address reachable from NPM.
NPM_IDENTITY=
NPM_SECRET=
NPM_FORWARD_HOST=
NPM_ACCESS_LIST_ID=0
# 0 requests/reuses a per-domain Let's Encrypt HTTP certificate automatically.
# Set a positive ID to reuse an existing certificate such as a wildcard.
NPM_CERTIFICATE_ID=0

# PostgreSQL platform database
NEXDEPLOY_POSTGRES_DB=nexdeploy
NEXDEPLOY_POSTGRES_USER=nexdeploy_admin
NEXDEPLOY_POSTGRES_PASSWORD=
