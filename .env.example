# Used by Docker Compose on the VPS. Never commit the real .env file.
NEXDEPLOY_ENCRYPTION_KEY=replace-with-a-long-random-secret
EXECUTOR_TOKEN=replace-with-a-long-random-token
PANEL_PORT=3000

# Optional Nginx Proxy Manager compose override.
# NPM admin UI will be available on NPM_ADMIN_PORT.
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# PostgreSQL platform database
NEXDEPLOY_POSTGRES_DB=nexdeploy
NEXDEPLOY_POSTGRES_USER=nexdeploy_admin
NEXDEPLOY_POSTGRES_PASSWORD=
