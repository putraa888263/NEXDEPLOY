PORT=8787
HOST=127.0.0.1
EXECUTOR_TOKEN=change-this-to-a-long-random-token
PROJECTS_DIR=/opt/nexdeploy/projects

# Phase 1 Laravel runtime: host port range allocated to deployed app
# containers. Must not overlap 8088 (panel) or 8787 (executor) — the
# allocator already excludes those regardless of this range.
# DEPLOY_PORT_MIN=20000
# DEPLOY_PORT_MAX=29999
PROJECTS_VOLUME=nexdeploy_executor-projects
